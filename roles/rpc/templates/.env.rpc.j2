# ============================================================================
# .env.rpc — RPC Node (docker-compose environment)
# ============================================================================
# Init params (chain_id, moniker, join sources, upstream RPC) are now in the
# YAML node config used by `umeshctl init rpc --config <yaml>`.
# This file contains ONLY docker-compose interpolation variables.
# ============================================================================

# Docker image
NODE_IMAGE={{ docker_image }}

# Docker labels
ENVIRONMENT={{ environment | default('production') }}

# ----------------------------------------------------------------------------
# Host port bindings (compose)
# Inside the container ports are always standard (26656/26657/1317/9090/9091/26660);
# *_BIND_IP and *_PORT control host-side publication only.
# ----------------------------------------------------------------------------
RPC_P2P_BIND_IP="{{ rpc_p2p_bind_ip }}"
RPC_RPC_BIND_IP="{{ rpc_rpc_bind_ip }}"

# ----------------------------------------------------------------------------
# Container resource limits (compose)
# ----------------------------------------------------------------------------
CPU_LIMIT={{ cpu_limit_rpc | default('2.0') }}
MEMORY_LIMIT={{ memory_limit_rpc | default('8g') }}
MEMORY_RESERVATION={{ memory_reservation_rpc | default('4g') }}
