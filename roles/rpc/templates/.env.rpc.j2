# ============================================================================
# .env.rpc — RPC Node (public RPC)
# ============================================================================
# [container] РОЛЬ
NODE_MODE={{ node_mode }}

# ============================================================================
# [init|compose|container] ОБЩИЕ ПАРАМЕТРЫ СЕТИ
CHAIN_ID={{ chain_id }}
DENOM={{ denom }}
MIN_GAS_PRICE={{ min_gas_price }}
MONIKER={{ moniker }}
NODE_IMAGE=umesh-node:latest

# ============================================================================
# [init] ПАРАМЕТРЫ ИНИЦИАЛИЗАЦИИ (genesis, пиры) И upstream RPC
GENESIS_URL="{{ genesis_url }}"
GENESIS_SHA256="{{ genesis_sha256 | default('') }}"
PUBLIC_RPC_FALLBACK="{{ public_rpc_fallback | default('') }}"
SEEDS="{{ seeds }}"
PERSISTENT_PEERS="{{ persistent_peers }}"
RPC_UPSTREAM="{{ rpc_upstream }}"
REST_UPSTREAM="{{ rest_upstream }}"
P2P_UPSTREAM="{{ p2p_upstream }}"

# ============================================================================
# [compose] ПОРТЫ НА ХОСТЕ
RPC_P2P_BIND_IP="{{ rpc_p2p_bind_ip }}"
RPC_RPC_BIND_IP="{{ rpc_rpc_bind_ip }}"

# ============================================================================
# [compose] ЛИМИТЫ РЕСУРСОВ
CPU_LIMIT_RPC={{ cpu_limit_rpc }}
MEMORY_LIMIT_RPC={{ memory_limit_rpc }}
MEMORY_RESERVATION_RPC={{ memory_reservation_rpc }}

# ============================================================================
# [compose|container] OTEL
OTEL_ENDPOINT="http://otel-collector.monitoring.svc:4317"
OTEL_PROTOCOL="grpc"
ENVIRONMENT={{ environment | default('production') }}