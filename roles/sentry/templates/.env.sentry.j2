# ============================================================================
# .env.sentry — Sentry Node (public gateway)
# ============================================================================
# [container] РОЛЬ
NODE_MODE={{ node_mode }}

# ============================================================================
# [init|compose|container] ОБЩИЕ ПАРАМЕТРЫ СЕТИ
CHAIN_ID={{ chain_id }}
DENOM={{ denom }}
MIN_GAS_PRICE={{ min_gas_price }}
MONIKER={{ moniker }}
NODE_IMAGE=umesh-node:latest

# ============================================================================
# [init] ПАРАМЕТРЫ SENTRY-ИНИЦИАЛИЗАЦИИ (источники сети, peers)
GENESIS_URL="{{ genesis_url }}"
GENESIS_SHA256="{{ genesis_sha256 | default('') }}"
ADDRBOOK_URL="{{ addrbook_url | default('') }}"
ADDRBOOK_SHA256="{{ addrbook_sha256 | default('') }}"
PUBLIC_RPC_FALLBACK="{{ public_rpc_fallback | default('') }}"
SEEDS="{{ seeds }}"
PERSISTENT_PEERS="{{ persistent_peers }}"

# ============================================================================
# [init] СВЯЗЬ С ВАЛИДАТОРОМ
SENTRY_RPC="{{ sentry_rpc }}"
VALIDATOR_RPC="{{ validator_rpc }}"
SENTRY_EXTERNAL_ADDRESS="{{ sentry_external_address | default('') }}"
SENTRY_PUBLIC_IP="{{ sentry_public_ip | default('') }}"
EXTERNAL_PORT="{{ external_port | default('26656') }}"
USE_PRIVATE="{{ use_private | default('false') }}"

# ============================================================================
# [compose] ПОРТЫ НА ХОСТЕ
SENTRY_P2P_BIND_IP="{{ sentry_p2p_bind_ip }}"
SENTRY_RPC_BIND_IP="{{ sentry_rpc_bind_ip }}"
SENTRY_DC_BIND_IP="{{ sentry_dc_bind_ip }}"

# ============================================================================
# [compose] ЛИМИТЫ РЕСУРСОВ
CPU_LIMIT_SENTRY={{ cpu_limit_sentry }}
MEMORY_LIMIT_SENTRY={{ memory_limit_sentry }}
MEMORY_RESERVATION_SENTRY={{ memory_reservation_sentry }}

# ============================================================================
# [compose|container] OTEL
OTEL_ENDPOINT="http://otel-collector.monitoring.svc:4317"
OTEL_PROTOCOL="grpc"
ENVIRONMENT={{ environment | default('production') }}

# ============================================================================
# [SECURE] KEYRING
KEYRING_PASSWORD={{ keyring_password }}