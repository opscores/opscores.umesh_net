# ============================================================================
# .env.sentry — Sentry Node (docker-compose environment)
# ============================================================================
# Init params (chain_id, moniker, join sources, validator link) are now in the
# YAML node config used by `umeshctl init sentry --config <yaml>`.
# This file contains ONLY docker-compose interpolation variables.
# ============================================================================

# Docker image
NODE_IMAGE={{ docker_image }}

# Docker labels
ENVIRONMENT={{ environment | default('production') }}

# ----------------------------------------------------------------------------
# Host port bindings (compose)
# Inside the container ports are always standard (26656/26657/1317/9090/9091/26658/26660);
# *_BIND_IP and *_PORT control host-side publication only.
# ----------------------------------------------------------------------------
SENTRY_P2P_BIND_IP="{{ sentry_p2p_bind_ip }}"
SENTRY_RPC_BIND_IP="{{ sentry_rpc_bind_ip }}"
SENTRY_DC_BIND_IP="{{ sentry_dc_bind_ip }}"

# ----------------------------------------------------------------------------
# Container resource limits (compose)
# ----------------------------------------------------------------------------
CPU_LIMIT={{ cpu_limit_sentry | default('2.0') }}
MEMORY_LIMIT={{ memory_limit_sentry | default('8g') }}
MEMORY_RESERVATION={{ memory_reservation_sentry | default('4g') }}
