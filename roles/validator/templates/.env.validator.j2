# ============================================================================
# .env.validator — Validator Node (join existing blockchain)
# ============================================================================
# [container] РОЛЬ
NODE_MODE=join

# ============================================================================
# [init|compose|container] ОБЩИЕ ПАРАМЕТРЫ СЕТИ
CHAIN_ID={{ chain_id }}
DENOM={{ denom }}
MIN_GAS_PRICE={{ min_gas_price }}
MONIKER={{ moniker }}
NODE_IMAGE=umesh-node:latest

# ============================================================================
# [init] ПАРАМЕТРЫ ВАЛИДАТОРА (join)
KEYRING_PASSWORD={{ keyring_password }}
GENESIS_URL="{{ join_genesis_url }}"
GENESIS_SHA256="{{ join_genesis_sha256 | default('') }}"
ADDRBOOK_URL="{{ join_addrbook_url | default('') }}"
ADDRBOOK_SHA256="{{ join_addrbook_sha256 | default('') }}"
PUBLIC_RPC_FALLBACK="{{ join_public_rpc_fallback | default('') }}"
SENTRY_RPC="{{ join_sentry_rpc | default('') }}"
SEEDS="{{ join_seeds | default('') }}"
PERSISTENT_PEERS="{{ persistent_peers_for_join }}"

# ============================================================================
# [compose] ПОРТЫ НА ХОСТЕ
VALIDATOR_P2P_BIND_IP="{{ validator_p2p_bind_ip }}"
VALIDATOR_RPC_BIND_IP="{{ validator_rpc_bind_ip }}"

# ============================================================================
# [compose] ЛИМИТЫ РЕСУРСОВ
CPU_LIMIT={{ cpu_limit }}
MEMORY_LIMIT={{ memory_limit }}
MEMORY_RESERVATION={{ memory_reservation }}

# ============================================================================
# [compose|container] OTEL
OTEL_ENDPOINT="http://otel-collector.monitoring.svc:4317"
OTEL_PROTOCOL="grpc"
ENVIRONMENT={{ environment | default('production') }}