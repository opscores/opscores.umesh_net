# ============================================================================
# .env.validator — Validator Node (docker-compose environment)
# ============================================================================
# Init params (chain_id, moniker, join sources, keyring password) are now in the
# YAML node config used by `umeshctl init validator --config <yaml>`.
# This file contains ONLY docker-compose interpolation variables.
# ============================================================================

# Docker image
NODE_IMAGE={{ docker_image }}

# Docker labels
ENVIRONMENT={{ environment | default('production') }}

# ----------------------------------------------------------------------------
# Host port bindings (compose)
# Inside the container ports are always 26656/26657/26660; *_BIND_IP and *_PORT
# control host-side publication only.
# ----------------------------------------------------------------------------
VALIDATOR_P2P_BIND_IP="{{ validator_p2p_bind_ip }}"
VALIDATOR_RPC_BIND_IP="{{ validator_rpc_bind_ip }}"

# ----------------------------------------------------------------------------
# Container resource limits (compose)
# ----------------------------------------------------------------------------
CPU_LIMIT={{ cpu_limit }}
MEMORY_LIMIT={{ memory_limit }}
MEMORY_RESERVATION={{ memory_reservation }}
