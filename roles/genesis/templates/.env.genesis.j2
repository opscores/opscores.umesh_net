# ============================================================================
# .env.genesis — Genesis Validator (creates new blockchain)
# ============================================================================
# [container] РОЛЬ
NODE_MODE=genesis

# ============================================================================
# [init|compose|container] ОБЩИЕ ПАРАМЕТРЫ СЕТИ
CHAIN_ID={{ chain_id }}
DENOM={{ denom }}
MIN_GAS_PRICE={{ min_gas_price }}
MONIKER={{ moniker }}
NODE_IMAGE={{ docker_image }}

# ============================================================================
# [init] ПАРАМЕТРЫ ВАЛИДАТОРА (genesis)
KEYRING_PASSWORD={{ keyring_password }}
VALIDATOR_NAME="{{ validator_name }}"
STAKE_AMOUNT="{{ stake_amount }}{{ denom }}"
SELF_DELEGATION="{{ self_delegation }}{{ denom }}"
VALIDATOR_EXTERNAL_ADDRESS=""
VALIDATOR_COMMISSION_RATE="{{ commission_rate }}"
VALIDATOR_COMMISSION_MAX="{{ commission_max }}"
VALIDATOR_COMMISSION_CHANGE="{{ commission_change }}"
VALIDATOR_MIN_SELF_DELEGATION="{{ min_self_delegation }}"

# ============================================================================
# [compose] ПОРТЫ НА ХОСТЕ
VALIDATOR_P2P_BIND_IP="{{ validator_p2p_bind_ip }}"
VALIDATOR_RPC_BIND_IP="{{ validator_rpc_bind_ip }}"

# ============================================================================
# [compose] ЛИМИТЫ РЕСУРСОВ
CPU_LIMIT={{ cpu_limit }}
MEMORY_LIMIT={{ memory_limit }}
MEMORY_RESERVATION={{ memory_reservation }}

# ============================================================================
# [compose|container] OTEL
OTEL_ENDPOINT="http://otel-collector.monitoring.svc:4317"
OTEL_PROTOCOL="grpc"
ENVIRONMENT={{ environment | default('production') }}